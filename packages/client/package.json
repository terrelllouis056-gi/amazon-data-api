{
  "name": "amazon-data-api",
  "version": "0.2.1",
  "description": "Typed client for the Amazon Data API on RapidAPI: search, product details, reviews, offers, sellers, deals, categories, barcode lookup and best sellers across 23 marketplaces.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://rapidapi.com/terrelllouis056/api/amazon-data-api-search-product-reviews-best-sellers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "amazon",
    "amazon-api",
    "amazon-product-api",
    "pa-api",
    "paapi5",
    "amazon-scraper",
    "amazon-reviews",
    "amazon-best-sellers",
    "amazon-offers",
    "amazon-deals",
    "amazon-seller",
    "upc-lookup",
    "mcp",
    "mcp-server",
    "rapidapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terrelllouis056-gi/amazon-data-api.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/terrelllouis056-gi/amazon-data-api/issues"
  }
}
